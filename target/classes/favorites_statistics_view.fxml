<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.FavoritesStatisticsController"
            style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e9ecef);">

    <top>
        <StackPane style="-fx-background-color: #6c5ce7; -fx-padding: 15 0;">
            <effect>
                <DropShadow color="#00000044" radius="5" spread="0.05"/>
            </effect>
            <VBox alignment="CENTER" spacing="5">
                <Label text="Favorites Statistics"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;">
                    <font>
                        <Font name="System Bold" size="28.0"/>
                    </font>
                </Label>
                <Label fx:id="discountInfoLabel"
                       style="-fx-font-size: 15px; -fx-text-fill: #dfe6e9; -fx-font-style: italic;"/>
            </VBox>
        </StackPane>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="25" style="-fx-padding: 30 30 20 30;">
                <!-- Products Favorites Chart -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 8;">
                    <effect>
                        <DropShadow color="#00000022" radius="4" spread="0.02"/>
                    </effect>
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <Label text="Most Favorited Products"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3436;">
                        <font>
                            <Font name="System Bold" size="18.0"/>
                        </font>
                    </Label>
                    <Label text="View your customers' most loved items"
                           style="-fx-font-size: 14px; -fx-text-fill: #636e72;"/>
                    <BarChart fx:id="favoritesChart" legendVisible="false" animated="true"
                              style="-fx-background-color: transparent;" minHeight="300">
                        <xAxis>
                            <CategoryAxis label="Product Name"
                                          style="-fx-font-size: 12px; -fx-tick-label-fill: #636e72;"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Number of Favorites"
                                        style="-fx-font-size: 12px; -fx-tick-label-fill: #636e72;"/>
                        </yAxis>
                    </BarChart>
                </VBox>

                <!-- Categories Pie Chart -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 8;">
                    <effect>
                        <DropShadow color="#00000022" radius="4" spread="0.02"/>
                    </effect>
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <Label text="Favorites by Category"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3436;">
                        <font>
                            <Font name="System Bold" size="18.0"/>
                        </font>
                    </Label>
                    <Label text="See which product categories are trending"
                           style="-fx-font-size: 14px; -fx-text-fill: #636e72;"/>
                    <PieChart fx:id="categoriesChart" animated="true" labelLineLength="20"
                              labelsVisible="true" style="-fx-pie-label-visible: true;" minHeight="300"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 0 0 30 0;">

            <Button text="Back to Dashboard" onAction="#handleBackToDashboard"
                    style="-fx-background-color: #6c5ce7; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-padding: 12 20; -fx-background-radius: 5; -fx-cursor: hand;">
                <effect>
                    <DropShadow color="#00000033" radius="3" spread="0.01"/>
                </effect>
            </Button>
        </HBox>
    </bottom>
</BorderPane>