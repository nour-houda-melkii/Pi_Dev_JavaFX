<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: #f5f7fa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminDashboardController">
    <!-- Left Sidebar Navigation -->
    <VBox prefHeight="600.0" prefWidth="218.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
        <!-- Logo Area -->
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="250.0" style="-fx-padding: 10 20;">
            <Label prefHeight="32.0" prefWidth="160.0" style="-fx-font-weight: bold; -fx-font-size: 22px; -fx-text-fill: #00BCD4;" text="SAHATECK" />
        </HBox>

        <!-- Navigation Items -->
        <VBox prefHeight="402.0" prefWidth="195.0" spacing="5.0" style="-fx-padding: 20 10;">
            <Label alignment="TOP_CENTER" prefHeight="22.0" prefWidth="159.0" style="-fx-font-size: 12px; -fx-text-fill: #9fa8b4; -fx-padding: 0 0 5 10;" text="PAGES" />

            <Button fx:id="productButton" prefHeight="40.0" prefWidth="158.0" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 0 0 0 15; -fx-border-color: transparent; -fx-text-fill: #3c4858; -fx-font-size: 14px;" text="Product Management">
                <graphic>
                    <Label style="-fx-text-fill: #3c4858; -fx-padding: 0 10 0 0;" text="⠀" />
                </graphic>
            </Button>

            <Button fx:id="eventButton" prefHeight="40.0" prefWidth="178.0" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 0 0 0 15; -fx-border-color: transparent; -fx-text-fill: #3c4858; -fx-font-size: 14px;" text="Event Management">
                <graphic>
                    <Label style="-fx-text-fill: #3c4858; -fx-padding: 0 10 0 0;" text="⠀" />
                </graphic>
            </Button>

            <Button fx:id="reclamationButton" prefHeight="40.0" prefWidth="230.0" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 0 0 0 15; -fx-border-color: transparent; -fx-text-fill: #3c4858; -fx-font-size: 14px;" text="Reclamation Management">
                <graphic>
                    <Label alignment="TOP_RIGHT" style="-fx-text-fill: #3c4858; -fx-padding: 0 10 0 0;" text="⠀" />
                </graphic>
            </Button>

            <Button fx:id="rendezVousButton" prefHeight="40.0" prefWidth="191.0" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 0 0 0 15; -fx-border-color: transparent; -fx-text-fill: #3c4858; -fx-font-size: 14px;" text="Appointment Management">
                <graphic>
                    <Label style="-fx-text-fill: #3c4858; -fx-padding: 0 10 0 0;" text="⠀" />
                </graphic>
            </Button>
         <Button fx:id="productButton1" prefHeight="40.0" prefWidth="158.0" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 0 0 0 15; -fx-border-color: transparent; -fx-text-fill: #3c4858; -fx-font-size: 14px;" text="Posts Managament ">
            <graphic>
               <Label style="-fx-text-fill: #3c4858; -fx-padding: 0 10 0 0;" text="⠀" />
            </graphic>
         </Button>

            <Button fx:id="profileButton" prefHeight="40.0" prefWidth="230.0" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 0 0 0 15; -fx-border-color: transparent; -fx-text-fill: #3c4858; -fx-font-size: 14px;" text="Profile">
                <graphic>
                    <Label style="-fx-text-fill: #3c4858; -fx-padding: 0 10 0 0;" text="⠀" />
                </graphic>
            </Button>

            <Button fx:id="signOutButton" prefHeight="40.0" prefWidth="230.0" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 0 0 0 15; -fx-border-color: transparent; -fx-text-fill: #3c4858; -fx-font-size: 14px;" text="Sign Out">
                <graphic>
                    <Label style="-fx-text-fill: #3c4858; -fx-padding: 0 10 0 0;" text="⠀" />
                </graphic>
            </Button>
        </VBox>
    </VBox>

    <!-- Main Content Area - Now uses AnchorPane constraints to fill remaining space -->
    <AnchorPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <!-- Top Navigation Bar -->
        <!-- Inside the top navigation bar HBox, modify the categories button and add a new button -->
        <HBox alignment="CENTER_RIGHT" prefHeight="60.0" spacing="10.0" style="-fx-background-color: white; -fx-padding: 0 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 2, 0, 0, 2);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <Button fx:id="frontButton" onAction="#handleFrontView" prefHeight="35.0" prefWidth="120.0" style="-fx-font-size: 13px; -fx-background-color: #00BCD4; -fx-text-fill: white; -fx-background-radius: 5;">
                <text>Front View</text>
            </Button>
            <Button fx:id="categoriesButton" onAction="#handleViewCategories" prefHeight="35.0" prefWidth="120.0" style="-fx-font-size: 13px; -fx-background-color: #00BCD4; -fx-text-fill: white; -fx-background-radius: 5;">
                <text>View Categories</text>
            </Button>
            <Button fx:id="addCategoryButton" onAction="#handleAddCategory" prefHeight="35.0" prefWidth="120.0" style="-fx-font-size: 13px; -fx-background-color: #00BCD4; -fx-text-fill: white; -fx-background-radius: 5;">
                <text>Add Category</text>
            </Button>
            <Button fx:id="tableViewButton" onAction="#handleTableViewButton" prefHeight="35.0" prefWidth="120.0" style="-fx-font-size: 13px; -fx-background-color: #00BCD4; -fx-text-fill: white; -fx-background-radius: 5;">
                <text>Add Product</text>
            </Button>
         
            <Button onAction="#handleDataHistory" prefHeight="35.0" prefWidth="120.0" style="-fx-font-size: 13px; -fx-background-color: #00BCD4; -fx-text-fill: white; -fx-background-radius: 5;" text="Data History" />
            <Button onAction="#handleFavoritesStatistics" prefHeight="35.0" prefWidth="160.0"
                    style="-fx-font-size: 13px; -fx-background-color: #00BCD4; -fx-text-fill: white; -fx-background-radius: 5;"
                    text="Favorites Stats" />
            <HBox />
        </HBox>
        <!-- Page Title -->
        <Label alignment="TOP_CENTER" prefHeight="40.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Product Management" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="80.0" />

        <!-- Sorting Options -->
        <HBox alignment="TOP_CENTER" prefHeight="30.0" spacing="10.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="120.0">
            <Label alignment="TOP_RIGHT" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;" text="Sort by:" />
            <ComboBox fx:id="sortComboBox" prefHeight="30.0" prefWidth="150.0" style="-fx-background-radius: 5;" />
            <HBox />
        </HBox>

        <!-- Product Container with styled scrollpane - Now uses AnchorPane constraints -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="160.0">
            <FlowPane fx:id="productContainer" hgap="20" style="-fx-padding: 20; -fx-background-color: white;" vgap="20" />
        </ScrollPane>
    </AnchorPane>
</AnchorPane>
