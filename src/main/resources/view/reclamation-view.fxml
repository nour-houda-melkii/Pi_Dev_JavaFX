<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ReclamationViewController" spacing="15" style="-fx-padding: 20;">

    <Label text="Liste des Réclamations" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Label text="Filtrer par type:"/>
        <ComboBox fx:id="typeFilter" promptText="Tous les types"/>

        <Label text="Filtrer par statut:"/>
        <ComboBox fx:id="statusFilter" promptText="Tous les statuts"/>

        <Button text="Actualiser" onAction="#refreshReclamations"/>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
        <FlowPane fx:id="cardsContainer" hgap="15" vgap="15" style="-fx-padding: 10;"/>
    </ScrollPane>
</VBox>