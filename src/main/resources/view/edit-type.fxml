<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.EditTypeController" spacing="15" style="-fx-padding: 20;"
      prefWidth="400" prefHeight="200">

    <Label text="Modifier Type de Réclamation" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Nom:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="nomField" prefWidth="250"/>
    </HBox>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Enregistrer" onAction="#handleSave"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 20;"/>
        <Button text="Annuler" onAction="#handleCancel"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 20;"/>
    </HBox>
</VBox>