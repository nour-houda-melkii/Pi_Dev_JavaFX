<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.controllers.ListMedecin"
      spacing="15"
      fx:id="mainContainer">

    <!-- Titre et sous-titre -->
    <VBox spacing="5">
        <Label fx:id="titleLabel" text="List of Doctors"/>
        <Label fx:id="subtitleLabel" text="Find here the complete list of doctors registered in our system."/>
    </VBox>

    <!-- Barre de recherche et bouton d'ajout -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" prefWidth="300" promptText="Search by name, email, phone..."/>
        <ComboBox fx:id="specialityComboBox" prefWidth="200" promptText="Select a speciality"/>
        <Button fx:id="searchButton" text="Search" onAction="#handleSearch"/>
        <Button fx:id="resetButton" text="Reset" onAction="#handleReset"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="unverifiedButton" text="Unverified Doctors" onAction="#handleShowUnverified" style="-fx-background-color: #00B4D8; -fx-text-fill: white; -fx-font-family: 'Poppins'; -fx-font-weight: bold;"/>
        <Button fx:id="addButton" text="+ Add a Doctor" onAction="#handleAddMedecin"/>
    </HBox>

    <!-- ListView des médecins -->
    <ListView fx:id="medecinListView" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="No doctors found." style="-fx-text-fill: #6c757d; -fx-font-family: 'Poppins';"/>
        </placeholder>
    </ListView>

    <!-- Pagination (à implémenter) -->
    <HBox alignment="CENTER" spacing="5">
        <!-- Ici vous pouvez ajouter votre pagination -->
    </HBox>
</VBox>