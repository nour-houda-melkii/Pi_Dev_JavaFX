<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.paint.*?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.FrontOfficeController">
    <stylesheets>
        <URL value="@../../styles/styleFrontOffice/styles.css" />
    </stylesheets>

    <!-- Header -->
    <HBox style="-fx-border-color: #f3f4f6; -fx-border-width: 0 0 1 0;" alignment="CENTER_LEFT" spacing="10" styleClass="header">
        <padding>
            <Insets top="10" right="15" bottom="10" left="15"/>
        </padding>
        <children>
            <Text fill="#1E90FF" style="-fx-font-family: 'Pacifico'; -fx-font-size: 24px;">SAHATECH</Text>
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button styleClass="icon-button">
                    <graphic>
                        <ImageView fitWidth="20" fitHeight="20">
                            <image>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="connexionButton" text="CONNEXION" styleClass="outline-button" />
                <Button fx:id="inscriptionButton" text="INSCRIPTION" styleClass="primary-button" />
            </HBox>
        </children>
    </HBox>

    <!-- Navigation -->
    <HBox style="-fx-border-color: #f3f4f6; -fx-border-width: 0 0 1 0;" alignment="CENTER" spacing="20">
        <padding>
            <Insets top="10" right="15" bottom="10" left="15"/>
        </padding>
        <children>
            <HBox spacing="30" alignment="CENTER_LEFT">
                <Hyperlink fx:id="accueilLink" text="Accueil" style="-fx-text-fill: #1E90FF; -fx-font-weight: bold;" />
                <Hyperlink fx:id="produitsLink" text="Produits" />
                <Hyperlink fx:id="evenementsLink" text="Événements" />
                <Hyperlink fx:id="articlesLink" text="Articles" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <HBox style="-fx-background-color: #f9fafb; -fx-background-radius: 20;" alignment="CENTER_LEFT" spacing="5">
                    <padding>
                        <Insets top="5" right="10" bottom="5" left="10"/>
                    </padding>
                    <ImageView fitWidth="16" fitHeight="16">
                        <image>
                        </image>
                    </ImageView>
                    <TextField fx:id="searchField" promptText="Rechercher..." style="-fx-background-color: transparent; -fx-padding: 0 0 0 5;" />
                </HBox>
                <Button styleClass="icon-button">
                    <graphic>
                        <StackPane>
                            <ImageView fitWidth="20" fitHeight="20">
                                <image>
                                </image>
                            </ImageView>
                            <Circle radius="8" fill="#e5e7eb" />
                            <Text text="0" style="-fx-font-size: 10px;" />
                        </StackPane>
                    </graphic>
                </Button>
                <Button styleClass="icon-button">
                    <graphic>
                        <StackPane>
                            <ImageView fitWidth="20" fitHeight="20">
                                <image>
                                </image>
                            </ImageView>
                            <Circle radius="8" fill="#e5e7eb" />
                            <Text text="0" style="-fx-font-size: 10px;" />
                        </StackPane>
                    </graphic>
                </Button>
            </HBox>
        </children>
    </HBox>

    <!-- Main Content -->
    <HBox alignment="TOP_CENTER" spacing="50" style="-fx-background-color: white;">
        <padding>
            <Insets top="50" right="30" bottom="50" left="30"/>
        </padding>
        <children>
            <!-- Company Info -->
            <VBox spacing="20" prefWidth="400">
                <Text fill="#1E90FF" style="-fx-font-family: 'Pacifico'; -fx-font-size: 30px;">SAHATECH</Text>
                <Text style="-fx-fill: #374151; -fx-font-size: 14px; -fx-line-spacing: 5px;" wrappingWidth="400">
                    Notre application est conçue pour simplifier la gestion de vos catégories et produits, offrant une interface intuitive et des fonctionnalités puissantes pour une expérience utilisateur optimale.
                </Text>

                <VBox spacing="15">
                    <HBox spacing="10" alignment="TOP_LEFT">
                        <ImageView fitWidth="20" fitHeight="20">
                            <image>
                            </image>
                        </ImageView>
                        <Text style="-fx-fill: #374151; -fx-font-size: 14px;" wrappingWidth="350">
                            Pôle Technologique El Ghazela, Ariana, Tunisie
                        </Text>
                    </HBox>

                    <HBox spacing="10" alignment="TOP_LEFT">
                        <ImageView fitWidth="20" fitHeight="20">
                            <image>
                            </image>
                        </ImageView>
                        <Hyperlink text="sahatech@gmail.com" style="-fx-text-fill: #374151; -fx-font-size: 14px;" />
                    </HBox>

                    <HBox spacing="10" alignment="TOP_LEFT">
                        <ImageView fitWidth="20" fitHeight="20">
                            <image>
                            </image>
                        </ImageView>
                        <Hyperlink text="70 685 685" style="-fx-text-fill: #374151; -fx-font-size: 14px;" />
                    </HBox>
                </VBox>

                <HBox spacing="10">
                    <Button styleClass="social-button">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20">
                                <image>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button styleClass="social-button">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20">
                                <image>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button styleClass="social-button">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20">
                                <image>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button styleClass="social-button">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20">
                                <image>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button styleClass="social-button">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20">
                                <image>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>

            <!-- Opening Hours -->
            <VBox style="-fx-background-color: white; -fx-border-color: #f3f4f6; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);" spacing="20" prefWidth="400">
                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>
                <Text style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #1f2937;">Heures d'Ouverture</Text>

                <VBox spacing="15">
                    <HBox alignment="CENTER" spacing="100" style="-fx-border-color: #f3f4f6; -fx-border-width: 0 0 1 0;">
                        <padding>
                            <Insets bottom="10"/>
                        </padding>
                        <Text style="-fx-fill: #374151; -fx-font-size: 14px;">Lundi - Jeudi</Text>
                        <Text style="-fx-fill: #1E90FF; -fx-font-weight: bold; -fx-font-size: 14px;">8:00 - 18:00</Text>
                    </HBox>

                    <HBox alignment="CENTER" spacing="100" style="-fx-border-color: #f3f4f6; -fx-border-width: 0 0 1 0;">
                        <padding>
                            <Insets bottom="10"/>
                        </padding>
                        <Text style="-fx-fill: #374151; -fx-font-size: 14px;">Vendredi - Samedi</Text>
                        <Text style="-fx-fill: #1E90FF; -fx-font-weight: bold; -fx-font-size: 14px;">10:00 - 16:00</Text>
                    </HBox>

                    <HBox alignment="CENTER" spacing="100" style="-fx-border-color: #f3f4f6; -fx-border-width: 0 0 1 0;">
                        <padding>
                            <Insets bottom="10"/>
                        </padding>
                        <Text style="-fx-fill: #374151; -fx-font-size: 14px;">Dimanche</Text>
                        <Text style="-fx-fill: #f97316; -fx-font-weight: bold; -fx-font-size: 14px;">Urgence uniquement</Text>
                    </HBox>

                    <HBox alignment="CENTER" spacing="100">
                        <Text style="-fx-fill: #374151; -fx-font-size: 14px;">Personnel</Text>
                        <Text style="-fx-fill: #1E90FF; -fx-font-weight: bold; -fx-font-size: 14px;">19:00 - 21:00</Text>
                    </HBox>
                </VBox>

                <Button fx:id="rendezvousButton" text="Prendre Rendez-vous" styleClass="primary-button" maxWidth="Infinity" />
            </VBox>
        </children>
    </HBox>

    <!-- Footer -->
    <VBox style="-fx-background-color: #f9fafb;">
        <padding>
            <Insets top="50" right="30" bottom="50" left="30"/>
        </padding>
        <HBox spacing="50" alignment="TOP_CENTER">
            <padding>
                <Insets bottom="30"/>
            </padding>
            <VBox spacing="15" prefWidth="300">
                <Text fill="#1E90FF" style="-fx-font-family: 'Pacifico'; -fx-font-size: 24px;">SAHATECH</Text>
                <Text style="-fx-fill: #6b7280; -fx-font-size: 14px; -fx-line-spacing: 5px;" wrappingWidth="300">
                    Solutions technologiques innovantes pour votre entreprise. Nous simplifions la gestion de vos produits et services.
                </Text>
            </VBox>

            <VBox spacing="15" prefWidth="200">
                <Text style="-fx-font-weight: bold; -fx-fill: #1f2937; -fx-font-size: 16px;">Liens Rapides</Text>
                <VBox spacing="8">
                    <Hyperlink text="Accueil" />
                    <Hyperlink text="Produits" />
                    <Hyperlink text="Événements" />
                    <Hyperlink text="Articles" />
                    <Hyperlink text="À propos" />
                    <Hyperlink text="Contact" />
                </VBox>
            </VBox>

            <VBox spacing="15" prefWidth="300">
                <Text style="-fx-font-weight: bold; -fx-fill: #1f2937; -fx-font-size: 16px;">Newsletter</Text>
                <Text style="-fx-fill: #6b7280; -fx-font-size: 14px; -fx-line-spacing: 5px;" wrappingWidth="300">
                    Inscrivez-vous pour recevoir nos dernières nouvelles et mises à jour.
                </Text>
                <HBox>
                    <TextField promptText="Votre email" style="-fx-background-radius: 8 0 0 8;" />
                    <Button fx:id="newsletterButton" text="S'abonner" style="-fx-background-radius: 0 8 8 0; -fx-background-color: #1E90FF; -fx-text-fill: white;" />
                </HBox>
            </VBox>
        </HBox>

        <HBox alignment="CENTER" spacing="200" style="-fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="30"/>
            </padding>
            <Text style="-fx-fill: #6b7280; -fx-font-size: 12px;">© 2025 SAHATECH. Tous droits réservés.</Text>
            <HBox spacing="20">
                <Hyperlink text="Politique de confidentialité" style="-fx-font-size: 12px;" />
                <Hyperlink text="Conditions d'utilisation" style="-fx-font-size: 12px;" />
            </HBox>
        </HBox>
    </VBox>
</VBox>