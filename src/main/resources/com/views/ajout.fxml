<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<AnchorPane prefHeight="600" prefWidth="800" stylesheets="" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.Ajout" style="-fx-background-color:white;">
   <!-- En-tête avec le logo et le nom de l'application -->
   <VBox spacing="10" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <!-- Titre de l'application -->


      <!-- Navbar en haut - visible="false" par défaut pour qu'elle n'apparaisse pas pendant la connexion -->
      <HBox fx:id="navbar" alignment="CENTER" spacing="20" style="-fx-background-color: #F8F8FF ; -fx-padding: 10px;" visible="false">
         <Button onAction="#populateDoctorGrid" styleClass="button-navbar" text="Prendre Rendez-vous" />
         <Button onAction="#showAppointmentsListPane" styleClass="button-navbar" text="Voir mes Rendez-vous" />
         <Button onAction="#showOnlineAppointmentsPane" styleClass="button-navbar" text="Mes Consultations En Ligne " />

         <Button onAction="#showNotificationsPane" styleClass="button-navbar" text="Voir mes Notifications" />

         <Button onAction="#showChatbotPane" styleClass="button-navbar" text="Assistant Médical" />


      </HBox>
   </VBox>





   <!-- Notifications - avec plus d'espace depuis le haut -->
   <VBox fx:id="notificationsPane" spacing="15" visible="false"
         AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="150.0"
         style="-fx-background-color: white; -fx-border-color: #dddddd; -fx-border-radius: 4;"
         maxWidth="1000" prefWidth="900">
      <padding>
         <Insets bottom="20" left="20" right="20" top="20" />
      </padding>
      <HBox alignment="CENTER_LEFT">
         <Label text="Vos Notifications :"
                style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" />
      </HBox>
      <Separator style="-fx-background-color: #dddddd; -fx-opacity: 0.6;" />
      <GridPane fx:id="notificationsGrid" gridLinesVisible="false" hgap="0" vgap="0"
                style="-fx-border-color: #dddddd; -fx-border-radius: 4;">
         <padding>
            <Insets bottom="0" left="0" right="0" top="0" />
         </padding>
      </GridPane>
      <Label fx:id="notificationsMessage" textFill="green" />
   </VBox>
   <!-- Liste des Médecins avec mise en page améliorée -->
   <VBox fx:id="doctorPane" layoutX="4.0" layoutY="135.0" prefHeight="502.0" prefWidth="840.0" spacing="15" visible="false" AnchorPane.leftAnchor="4.0" AnchorPane.rightAnchor="4.0" AnchorPane.topAnchor="135.0">
      <padding>
         <Insets bottom="15" left="15" right="15" top="15" />
      </padding>

      <!-- Titre avec meilleur alignement -->
      <Label contentDisplay="CENTER" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #2C3E50; -fx-alignment: center;" text="Médecins disponibles" textAlignment="CENTER" />

      <!-- Barre de recherche avec un meilleur design -->
      <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 10px; -fx-background-color: #f8f8f8; -fx-background-radius: 5px; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;">
         <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Rechercher par spécialité:" />
         <TextField fx:id="specialitySearchField" prefWidth="250" promptText="Entrez une spécialité" />
         <Button onAction="#searchDoctorsBySpeciality" styleClass="button-primary" text="Rechercher" />
         <Button onAction="#resetDoctorSearch" styleClass="button-secondary" text="Réinitialiser" />
      </HBox>

      <!-- Conteneur pour la grille de médecins avec une bordure et un fond -->
      <GridPane fx:id="doctorGrid" alignment="CENTER" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5px; -fx-background-radius: 5px;" VBox.vgrow="ALWAYS" />

      <!-- Message d'erreur avec style amélioré -->
      <Label fx:id="doctorMessage" style="-fx-font-size: 13px; -fx-padding: 5px;" textFill="red" />
   </VBox>



   <VBox fx:id="appointmentPane" layoutX="120.0" layoutY="150.0" prefHeight="566.0" prefWidth="563.0" spacing="25" style="-fx-background-color: white; -fx-padding: 40; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.2), 10, 0, 0, 5); -fx-alignment: CENTER;" visible="false" AnchorPane.topAnchor="150.0"> <Label style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: rgb(135, 206, 235);" text="Prenez un Rendez-vous" />
      <HBox alignment="CENTER_LEFT" spacing="20">
         <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="État :" />
         <ChoiceBox fx:id="stateChoiceBox" prefWidth="240" style="-fx-background-color: rgb(240, 248, 255); -fx-border-color: rgb(135, 206, 235); -fx-border-radius: 5; -fx-font-size: 14;" />
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="20">
         <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Date :" />
         <DatePicker fx:id="datePicker" style="-fx-background-color: rgb(240, 248, 255); -fx-border-color: rgb(135, 206, 235); -fx-border-radius: 5; -fx-font-size: 14;" />
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="20">
         <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Heure :" />
         <ComboBox fx:id="timeComboBox" promptText="Sélectionnez une heure" style="-fx-background-color: rgb(240, 248, 255); -fx-border-color: rgb(135, 206, 235); -fx-border-radius: 5; -fx-font-size: 14;" />
      </HBox>

      <Button onAction="#handleAppointmentCreation" prefWidth="200" style="-fx-background-color: rgb(135, 206, 235); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 24; -fx-border-radius: 5; -fx-font-size: 16;" text="Prendre Rendez-vous" />

      <Label fx:id="appointmentMessage" style="-fx-font-size: 14px;" textFill="red" />
   </VBox>



   <!-- Affichage des Rendez-vous avec mise en page améliorée -->
   <VBox fx:id="appointmentsListPane" layoutX="4.0" layoutY="150" prefHeight="500.0" prefWidth="850.0" spacing="15" visible="false" AnchorPane.leftAnchor="4.0" AnchorPane.rightAnchor="-4.0" AnchorPane.topAnchor="150.0">
      <padding>
         <Insets bottom="15" left="15" right="15" top="15" />
      </padding>

      <!-- Titre avec meilleur alignement -->
      <Label alignment="TOP_LEFT" contentDisplay="RIGHT" prefWidth="710.0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Vos Rendez-vous :">
         <font>
            <Font size="24.0" />
         </font>
      </Label>

      <!-- Contrôles de tri dans un conteneur stylisé -->
      <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 10px; -fx-background-color: #f8f8f8; -fx-background-radius: 5px; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;">
         <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Trier par date:" />
         <Button onAction="#sortAppointmentsByDateAsc" style="-fx-background-color: #87CEEB; -fx-text-fill: white;" styleClass="button-secondary" text="Croissant" />
         <Button onAction="#sortAppointmentsByDateDesc" style="-fx-background-color: #87CEEB; -fx-text-fill: white;" styleClass="button-secondary" text="Décroissant" />
      </HBox>

      <!-- Conteneur pour la grille de rendez-vous avec une bordure et un fond -->
      <GridPane fx:id="appointmentsGrid" alignment="CENTER" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5px; -fx-background-radius: 5px;" VBox.vgrow="ALWAYS" />

      <!-- Message d'information avec style amélioré -->
      <Label fx:id="appointmentsMessage" style="-fx-font-size: 13px; -fx-padding: 5px;" textFill="green" />
   </VBox>







   <!-- Affichage des Rendez-vous en ligne avec mise en page améliorée -->
   <VBox fx:id="onlineAppointmentsPane" layoutX="20" layoutY="150" prefHeight="500.0" prefWidth="740.0" spacing="15" visible="false" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="150.0">
      <padding>
         <Insets bottom="15" left="15" right="15" top="15" />
      </padding>

      <!-- Titre avec meilleur alignement -->
      <Label alignment="TOP_LEFT" contentDisplay="CENTER" prefWidth="710.0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Vos Rendez-vous en ligne : " textAlignment="CENTER">
         <font>
            <Font size="24.0" />
         </font>
      </Label>

      <!-- Info box avec instructions -->
      <HBox style="-fx-padding: 10px; -fx-background-color: #f8f8f8; -fx-background-radius: 5px; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;">
         <Label style="-fx-font-style: italic; -fx-text-fill: #5a5a5a;" text="Sélectionnez un rendez-vous pour pouvoir rejoindre la consultation en ligne" wrapText="true" />
      </HBox>

      <!-- Conteneur pour la grille de rendez-vous avec une bordure et un fond -->
      <GridPane fx:id="onlineAppointmentsGrid" alignment="CENTER" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5px; -fx-background-radius: 5px;" VBox.vgrow="ALWAYS" />

      <!-- Message d'information avec style amélioré -->
      <Label fx:id="onlineAppointmentsMessage" style="-fx-font-size: 13px; -fx-padding: 5px; -fx-font-weight: bold;" textFill="green" />

      <!-- Bouton pour rejoindre la consultation dans un conteneur stylisé -->
      <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10px;">
         <Button fx:id="joinMeetingButton" onAction="#joinOnlineMeeting" style="-fx-background-color: #87CEEB; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-border-radius: 5px; -fx-background-radius: 5px;" text="Rejoindre la consultation" />
      </HBox>
   </VBox>







   <!-- Interface du Chatbot Médical -->
   <VBox fx:id="chatbotPane" alignment="CENTER" layoutX="20" layoutY="150" prefHeight="520.0" prefWidth="770.0" spacing="15" visible="false" AnchorPane.topAnchor="150.0">
      <padding>
         <Insets bottom="10" left="10" right="10" top="10" />
      </padding>
      <Label alignment="CENTER" prefHeight="23.0" prefWidth="610.0" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Assistant Médical - Chatbot" />

      <!-- Zone d'historique des messages -->
      <ScrollPane fitToWidth="true" prefHeight="336.0" prefWidth="750.0" style="-fx-background: white;">
         <VBox fx:id="chatHistoryBox" spacing="10" style="-fx-padding: 10;" />
      </ScrollPane>

      <!-- Zone de saisie et bouton d'envoi -->
      <HBox alignment="CENTER_LEFT" spacing="10">
         <TextField fx:id="chatInputField" onAction="#sendChatMessage" promptText="Posez votre question médicale ici..." HBox.hgrow="ALWAYS" />
         <Button onAction="#sendChatMessage" styleClass="button-primary" text="Envoyer" />
      </HBox>

      <!-- Indicateur de chargement -->
      <ProgressIndicator fx:id="chatLoadingIndicator" visible="false" />
      <Label fx:id="chatbotMessage" textFill="green" />
   </VBox>

</AnchorPane>