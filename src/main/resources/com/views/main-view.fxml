<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MainController"
            stylesheets="@../styles/main.css">

    <!-- Top: Header -->
    <top>
        <HBox style="-fx-background-color: #3498db; -fx-padding: 15;" alignment="CENTER_LEFT">
            <Label text="SAHATECK" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;">
                <font>
                    <Font name="Berlin Sans FB" size="24.0" />
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <StackPane fx:id="notificationBellContainer">
                <Button fx:id="notificationBellButton" onAction="#handleNotificationBell"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 40; -fx-min-height: 40;">
                    <graphic>
                        <SVGPath content="M12,22A2,2 0 0,0 14,20H10A2,2 0 0,0 12,22M18,16V11C18,7.93 16.36,5.36 13.5,4.68V4A1.5,1.5 0 0,0 12,2.5A1.5,1.5 0 0,0 10.5,4V4.68C7.63,5.36 6,7.92 6,11V16L4,18V19H20V18L18,16Z"
                                 fill="WHITE" />
                    </graphic>
                </Button>
                <Label fx:id="notificationCountLabel"
                       style="-fx-background-color: rgb(135,206,235); -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 2 6; -fx-font-weight: bold;"
                       StackPane.alignment="TOP_RIGHT"
                       visible="false"
                       text="0" />
            </StackPane>
            <Button fx:id="backendButton" onAction="#handleBackend"
                    style="-fx-background-color: #3498db ; -fx-text-fill: #3498db; -fx-background-radius: 5; -fx-padding: 8 15;"
                    text="Backend" />
            <Label fx:id="notificationLabel"
                   text=""
                   style="-fx-background-color: rgb(135,206,235); -fx-text-fill: white; -fx-padding: 10; -fx-font-weight: bold;"
                   visible="false"
                   managed="false"/>
        </HBox>
    </top>

    <!-- Center: Content -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f5f7fa;">
            <!-- Header avec bouton d'ajout -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <TextField fx:id="searchField" promptText="Rechercher par description, date ou médecin..."
                           style="-fx-background-radius: 5; -fx-padding: 8 15; -fx-pref-width: 300;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addBtn" text="+ Ajouter" onAction="#handleAdd"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 5; -fx-padding: 8 15;"/>
            </HBox>

            <!-- Cards Container -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <FlowPane fx:id="cardsContainer" hgap="15" vgap="15" style="-fx-padding: 10;">
                    <!-- Template de carte - sera généré dynamiquement -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 10;
                                -fx-border-radius: 10; -fx-border-color: #e0e0e0;
                                -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 1);
                                -fx-padding: 15; -fx-spacing: 12; -fx-min-width: 300;">
                        <!-- En-tête -->
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="typeLabel" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #00B4D8;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="dateLabel" style="-fx-text-fill: #7f8c8d; -fx-font-size: 13;"/>
                        </HBox>

                        <!-- Description -->
                        <Label fx:id="descLabel" style="-fx-text-fill: #34495e; -fx-wrap-text: true; -fx-padding: 0 0 5 0;"/>

                        <!-- Boutons d'action -->
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="editBtn" text="Edit" onAction="#handleEdit"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white;
                                           -fx-background-radius: 5; -fx-padding: 5 10;"/>
                            <Button fx:id="deleteBtn" text="Delete" onAction="#handleDelete"
                                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                           -fx-background-radius: 5; -fx-padding: 5 10;"/>
                        </HBox>
                    </VBox>
                </FlowPane>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>