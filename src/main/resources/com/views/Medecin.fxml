<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.paint.Color?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.controllers.MedecinController"
            prefWidth="1000" prefHeight="650"
            style="-fx-background-color: #f5f7fb;">

    <!-- Panneau de connexion -->
    <Pane fx:id="loginPaneMedecin" visible="true" prefWidth="1000" prefHeight="650">
        <VBox alignment="CENTER" spacing="25" layoutX="350" layoutY="150">
            <!-- Logo et nom de l'application -->
            <Label text="SAHATECH"
                   style="-fx-text-fill: #3498db; -fx-font-size: 36px; -fx-font-weight: bold;"/>

            <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                <Label text="Connexion Médecin"
                       style="-fx-text-fill: #2c3e50; -fx-font-size: 24px; -fx-font-weight: bold;"/>

                <VBox spacing="15" style="-fx-padding: 20 0 0 0;">
                    <TextField fx:id="emailFieldMedecin"
                               promptText="Adresse email"
                               style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-pref-width: 300;"/>

                    <PasswordField fx:id="passwordFieldMedecin"
                                   promptText="Mot de passe"
                                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-pref-width: 300;"/>

                    <Button text="Se connecter"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-pref-width: 120;"/>
                </VBox>

                <Label fx:id="loginMessageMedecin"
                       style="-fx-text-fill: #e74c3c; -fx-padding: 10 0 0 0;"/>
            </VBox>
        </VBox>
    </Pane>

    <!-- Tableau de bord avec navbar à gauche -->
    <Pane fx:id="dashboardPaneMedecin" visible="false" prefWidth="1000" prefHeight="650">
        <HBox>
            <!-- Navbar gauche -->
            <VBox style="-fx-background-color: #3498db; -fx-pref-width: 220; -fx-padding: 20 10;">
                <!-- En-tête navbar -->
                <VBox alignment="CENTER" spacing="15" style="-fx-padding: 0 0 30 0;">
                    <Label text="SAHATECH"
                           style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                    <Label text="Tableau de bord"
                           style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                </VBox>

                <!-- Boutons de navigation -->
                <VBox spacing="10">
                    <Button fx:id="rdvButton"
                            text="Rendez-vous"
                            onAction="#loadData"
                            prefWidth="200"
                            style="-fx-background-color: white; -fx-text-fill: #3498db; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12;">
                    </Button>



                    <Button fx:id="etatsButton"
                            text="Types de rendez-vous"
                            onAction="#chargerEtatsMedecin"
                            prefWidth="200"
                            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: white; -fx-border-radius: 8; -fx-padding: 12;">
                    </Button>
                    <Button fx:id="rdvEnLigneButton"
                            text="Consultations en ligne"
                            onAction="#afficherRendezVousEnLigne"
                            prefWidth="200"
                            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: white; -fx-border-radius: 8; -fx-padding: 12;">
                    </Button>
                    <Button fx:id="calendrierButton"
                            text="Calendrier"
                            onAction="#afficherCalendrier"
                            prefWidth="200"
                            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: white; -fx-border-radius: 8; -fx-padding: 12;">
                    </Button>
                    <Button fx:id="notificationsButton"
                            text="Notifications"
                            onAction="#afficherNotifications"
                            prefWidth="200"
                            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: white; -fx-border-radius: 8; -fx-padding: 12;">
                        <graphic>
                            <HBox alignment="CENTER_RIGHT">
                                <Label fx:id="notificationCountLabel"
                                       style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 50; -fx-padding: 2 6; -fx-font-size: 10px;"
                                       visible="false"/>
                            </HBox>
                        </graphic>
                    </Button>
                </VBox>

                <!-- Bouton déconnexion en bas -->
                <Pane VBox.vgrow="ALWAYS" />
                <Button text="Déconnexion"

                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12; -fx-pref-width: 200;"/>
            </VBox>

            <!-- Contenu principal -->
            <VBox spacing="20" HBox.hgrow="ALWAYS" style="-fx-padding: 25;">
                <!-- Section filtres -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <DatePicker fx:id="filterDatePicker" promptText="Filtrer par date"/>
                    <ComboBox fx:id="filterHeureComboBox" promptText="Filtrer par heure" prefWidth="150"/>
                    <ComboBox fx:id="filterEtatComboBox" promptText="Filtrer par état" prefWidth="150"/>
                    <Button text="Appliquer" onAction="#appliquerFiltres"
                            style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                    <Button text="Réinitialiser" onAction="#reinitialiserFiltres"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
                </HBox>

                <!-- StackPane pour afficher soit Rendez-vous, États, Calendrier ou Consultations en ligne au même endroit -->
                <StackPane HBox.hgrow="ALWAYS">
                    <!-- Section rendez-vous -->
                    <VBox fx:id="rendezVousSection" spacing="15"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                        <Label text="Rendez-vous à venir"
                               style="-fx-text-fill: #34495e; -fx-font-size: 20px; -fx-font-weight: semi-bold;"/>
                        <ScrollPane fx:id="scrollPane"
                                    style="-fx-background-color: transparent; -fx-border-color: #d6dbeb; -fx-border-radius: 10; -fx-pref-height: 450;">
                            <content>
                                <VBox fx:id="vboxContainer" spacing="15">
                                    <padding>
                                        <Insets top="10" right="10" bottom="10" left="10"/>
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <!-- NOUVELLE Section consultations en ligne -->
                    <VBox fx:id="rendezVousEnLigneSection" visible="false" spacing="15"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label text="Consultations en ligne"
                                   style="-fx-text-fill: #34495e; -fx-font-size: 20px; -fx-font-weight: semi-bold;"/>

                            <Region HBox.hgrow="ALWAYS" />

                            <Button fx:id="refreshOnlineAppointmentsButton"
                                    text="Actualiser"
                                    onAction="#handleRefreshOnlineAppointments"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                        </HBox>

                        <ScrollPane
                                style="-fx-background-color: transparent; -fx-border-color: #d6dbeb; -fx-border-radius: 10; -fx-pref-height: 450;">
                            <content>
                                <VBox fx:id="onlineAppointmentsContainer" spacing="5">
                                    <padding>
                                        <Insets top="10" right="10" bottom="10" left="10"/>
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <!-- Section états (masquée par défaut, même emplacement) -->
                    <VBox fx:id="etatsSection" visible="false" spacing="15"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                        <Label text="Types de rendez-vous disponibles"
                               style="-fx-text-fill: #34495e; -fx-font-size: 20px; -fx-font-weight: semi-bold;"/>
                        <ListView fx:id="listViewEtats"
                                  style="-fx-background-color: white; -fx-border-color: #d6dbeb; -fx-border-radius: 10; -fx-pref-height: 450;">
                            <placeholder>
                                <Label text="Aucun état disponible"
                                       style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                            </placeholder>
                        </ListView>
                    </VBox>

                    <!-- Section calendrier (masquée par défaut, même emplacement) -->
                    <!-- Utilisation d'un fx:include pour intégrer le contenu du calendrier avec son propre contrôleur -->
                    <VBox fx:id="calendrierSection" visible="false"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                        <Label text="Calendrier des Rendez-vous"
                               style="-fx-text-fill: #34495e; -fx-font-size: 20px; -fx-font-weight: semi-bold;"/>

                        <!-- Contenu du calendrier avec son propre contrôleur -->
                        <AnchorPane fx:id="calendarContainer">
                            <VBox alignment="CENTER" spacing="15" AnchorPane.topAnchor="0.0"
                                  AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0">
                                <!-- Navigation du mois -->
                                <HBox alignment="CENTER" spacing="20">
                                    <Button fx:id="prevMonthButton" text="&lt;"
                                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                                    <Label fx:id="moisAnneeCourant" style="-fx-font-size: 18; -fx-font-weight: bold;" text="Mois Année" />
                                    <Button fx:id="nextMonthButton" text="&gt;"
                                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                                </HBox>

                                <!-- En-têtes des jours de la semaine -->
                                <HBox alignment="CENTER" spacing="10">
                                    <Label text="Lun" style="-fx-font-weight: bold;" prefWidth="60" alignment="CENTER" />
                                    <Label text="Mar" style="-fx-font-weight: bold;" prefWidth="60" alignment="CENTER" />
                                    <Label text="Mer" style="-fx-font-weight: bold;" prefWidth="60" alignment="CENTER" />
                                    <Label text="Jeu" style="-fx-font-weight: bold;" prefWidth="60" alignment="CENTER" />
                                    <Label text="Ven" style="-fx-font-weight: bold;" prefWidth="60" alignment="CENTER" />
                                    <Label text="Sam" style="-fx-font-weight: bold;" prefWidth="60" alignment="CENTER" />
                                    <Label text="Dim" style="-fx-font-weight: bold;" prefWidth="60" alignment="CENTER" />
                                </HBox>

                                <!-- Grille pour les jours du mois -->
                                <GridPane fx:id="calendrierGrid" alignment="CENTER" hgap="5" vgap="5">
                                    <!-- Les boutons des jours seront ajoutés ici programmatiquement -->
                                </GridPane>
                            </VBox>
                        </AnchorPane>
                    </VBox>
                </StackPane>
            </VBox>
        </HBox>
    </Pane>
</AnchorPane>