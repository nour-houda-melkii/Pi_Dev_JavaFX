<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.StatisticsViewController" fitToWidth="true"
            style="-fx-background-color: #f5f7fa;">
    <VBox spacing="30" style="-fx-padding: 30 40 40 40;">
        <!-- Titre principal avec ligne décorative -->
        <VBox spacing="10">
            <Label text="Tableau de bord des statistiques"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Separator style="-fx-background-color: #3498db; -fx-pref-height: 3;"/>
            <Label text="Aperçu complet des données utilisateurs de la plateforme"
                   style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
        </VBox>

        <!-- Première rangée: Distributions par âge et par genre -->
        <TitledPane text="Démographie des utilisateurs" expanded="true"
                    style="-fx-font-size: 16px; -fx-font-weight: bold;">
            <VBox>
                <HBox spacing="30" VBox.vgrow="ALWAYS">
                    <!-- Carte pour la distribution par âge -->
                    <VBox fx:id="ageDistributionContainer" spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 8;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 5);">
                        <Label text="Distribution par âge"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <Label text="Répartition des patients et médecins par tranches d'âge"
                               style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;"/>
                    </VBox>

                    <!-- Carte pour la distribution par genre -->
                    <VBox fx:id="genderDistributionContainer" spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 8;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 5);">
                        <Label text="Distribution par genre"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <Label text="Proportion hommes/femmes parmi nos utilisateurs"
                               style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;"/>
                    </VBox>
                </HBox>
            </VBox>
        </TitledPane>

        <!-- Deuxième rangée: Utilisateurs actifs -->
        <TitledPane text="Engagement des utilisateurs" expanded="true"
                    style="-fx-font-size: 16px; -fx-font-weight: bold;">
            <VBox>
                <!-- Carte pour les utilisateurs les plus actifs -->
                <VBox fx:id="activeUsersContainer" spacing="10"
                      style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 5);">
                    <Label text="Utilisateurs les plus actifs (30 derniers jours)"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <Label text="Nombre de connexions par utilisateur"
                           style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;"/>
                </VBox>
            </VBox>
        </TitledPane>

        <!-- Footer avec dernière mise à jour -->
        <HBox alignment="CENTER_RIGHT">
            <Label text="Dernière mise à jour: " style="-fx-text-fill: #7f8c8d;"/>
        </HBox>
    </VBox>
</ScrollPane>