<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.controllers.WelcomeController"
           style="-fx-background-color: white;">
    
    <VBox alignment="CENTER" spacing="20">
        <padding>
            <Insets top="50" right="50" bottom="50" left="50"/>
        </padding>
        
        <Text text="Bienvenue sur SAHATECK"
              style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #2196f3;"/>
        
        <Text text="Système de Gestion des Événements"
              style="-fx-font-size: 24px; -fx-fill: #666;"/>
        
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 30 0 0 0;">
            <Text text="Pour commencer, sélectionnez une option dans le menu de gauche :"
                  style="-fx-font-size: 16px; -fx-fill: #666;"/>
            
            <VBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 20 0 0 0;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Region style="-fx-min-width: 5; -fx-background-color: #2196f3;"/>
                    <Text text="Dashboard - Vue d'ensemble de vos événements"
                          style="-fx-font-size: 14px;"/>
                </HBox>
                
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Region style="-fx-min-width: 5; -fx-background-color: #2196f3;"/>
                    <Text text="Gestion des Événements - Créer et gérer vos événements"
                          style="-fx-font-size: 14px;"/>
                </HBox>
                
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Region style="-fx-min-width: 5; -fx-background-color: #2196f3;"/>
                    <Text text="Gestion des Catégories - Organiser vos événements"
                          style="-fx-font-size: 14px;"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane> 