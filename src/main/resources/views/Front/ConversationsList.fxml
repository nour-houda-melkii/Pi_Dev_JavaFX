<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.front.ConversationsListController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #3498db; -fx-padding: 10;">
            <Label text="My Conversations" style="-fx-text-fill: white;">
                <font>
                    <Font name="System Bold" size="22"/>
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="refreshButton" text="Refresh" onAction="#refreshConversations">
            </Button>
        </HBox>
    </top>

    <center>
        <StackPane>
            <VBox fx:id="loadingBox" alignment="CENTER" visible="false">
                <ProgressIndicator />
                <Label text="Loading conversations..." style="-fx-padding: 10 0 0 0;"/>
            </VBox>

            <VBox fx:id="contentBox">
                <ListView fx:id="convListView" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="No conversations yet" style="-fx-text-fill: #7f8c8d;"/>
                    </placeholder>
                </ListView>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10;">
            <Label fx:id="statusLabel" text="" style="-fx-text-fill: #7f8c8d;" HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>

    <padding>
        <Insets bottom="10" left="10" right="10" top="10"/>
    </padding>
</BorderPane>