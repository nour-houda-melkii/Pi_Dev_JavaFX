<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.MainController">
    
    <!-- Barre latérale -->
    <left>
        <VBox spacing="10" styleClass="left" minWidth="250" prefWidth="280">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            
            <!-- Logo centré -->
            <HBox alignment="CENTER" prefWidth="Infinity">
                <ImageView fitHeight="80.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.png" />
                    </image>
                </ImageView>
            </HBox>
            
            <!-- Titre centré -->
            <HBox alignment="CENTER" prefWidth="Infinity">
                <Label styleClass="label-title" text="SAHATECK" />
            </HBox>
            
            <Separator />
            
            <!-- Menu items -->
            <Button fx:id="dashboardBtn" styleClass="sidebar-button" text="Dashboard" onAction="#handleDashboard" />
            
            <!-- Gestion des Utilisateurs (placeholder) -->
            <Button fx:id="usersManagementBtn" styleClass="sidebar-button" text="Gestion des Utilisateurs" onAction="#handlePlaceholder" />
            
            <!-- Gestion des Produits (placeholder) -->
            <Button fx:id="productsManagementBtn" styleClass="sidebar-button" text="Gestion des Produits" onAction="#handlePlaceholder" />
            
            <!-- Gestion des Rendez-vous (placeholder) -->
            <Button fx:id="appointmentsManagementBtn" styleClass="sidebar-button" text="Gestion des Rendez-vous" onAction="#handlePlaceholder" />
            
            <!-- Gestion des Événements avec sous-menus -->
            <VBox spacing="5" styleClass="sidebar-submenu-container">
                <Button fx:id="eventsManagementBtn" styleClass="sidebar-button" text="Gestion des Événements" onAction="#toggleEventsSubMenu" />
                
                <VBox fx:id="eventsSubMenu" spacing="5" managed="false" visible="false">
                    <padding>
                        <Insets left="20" />
                    </padding>
                    <Button styleClass="sidebar-sub-button" text="Événements" onAction="#handleEvents" />
                    <Button styleClass="sidebar-sub-button" text="Catégories" onAction="#handleCategories" />
                </VBox>
            </VBox>
            
            <!-- Gestion des Publications (placeholder) -->
            <Button fx:id="postsManagementBtn" styleClass="sidebar-button" text="Gestion des Publications" onAction="#handlePlaceholder" />
            
            <!-- Gestion des Réclamations (placeholder) -->
            <Button fx:id="complaintsManagementBtn" styleClass="sidebar-button" text="Gestion des Réclamations" onAction="#handlePlaceholder" />
        </VBox>
    </left>
    
    <!-- Zone de contenu principal -->
    <center>
        <BorderPane fx:id="contentArea">
            <!-- Le contenu sera chargé dynamiquement ici -->
        </BorderPane>
    </center>
</BorderPane>
