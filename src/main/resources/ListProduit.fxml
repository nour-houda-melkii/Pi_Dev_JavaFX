<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ListeProduitController">
    <children>
        <!-- Form Section with Border -->
        <VBox layoutX="20" layoutY="20" spacing="15" style="-fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: white; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">
            <children>
                <!-- Header with Back Button -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label alignment="TOP_CENTER" prefHeight="27.0" prefWidth="747.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Product Management" />
                    <HBox alignment="TOP_CENTER" HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleBackToAdmin" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 15;" text="Back to Dashboard" />
                </HBox>

                <!-- Form Fields -->
                <GridPane vgap="10">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="100.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" maxWidth="649.6000732421875" minWidth="200.0" prefWidth="400.8000244140625" />
                        <ColumnConstraints hgrow="NEVER" maxWidth="403.9999755859375" minWidth="150.0" prefWidth="403.9999755859375" />
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints minHeight="35" prefHeight="35" />
                        <RowConstraints minHeight="35" prefHeight="35" />
                        <RowConstraints minHeight="35" prefHeight="35" />
                        <RowConstraints minHeight="35" prefHeight="35" />
                        <RowConstraints minHeight="35" prefHeight="35" />
                        <RowConstraints minHeight="35" prefHeight="35" />
                    </rowConstraints>

                    <!-- Name Field -->
                    <Label style="-fx-font-weight: bold;" text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="nameField" prefHeight="32.0" prefWidth="594.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 0 10;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <!-- Description Field -->
                    <Label style="-fx-font-weight: bold;" text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="descriptionField" prefHeight="30.0" prefWidth="654.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 0 10;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Button fx:id="generateDescriptionButton" onAction="#generateAIDescription" prefHeight="27.0" prefWidth="118.0" style="-fx-background-color: #00BCD4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 5 7;" text="Generate AI" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                    <!-- Price Field -->
                    <Label style="-fx-font-weight: bold;" text="Price:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField fx:id="priceField" prefHeight="29.0" prefWidth="654.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 0 10;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <!-- Quantity Field -->
                    <Label style="-fx-font-weight: bold;" text="Quantity:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="quantityField" prefHeight="34.0" prefWidth="654.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 0 10;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <!-- Image Field -->
                    <Label style="-fx-font-weight: bold;" text="Image:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <TextField fx:id="imageField" editable="false" prefHeight="30.0" prefWidth="654.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 0 10;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    <Button alignment="TOP_CENTER" contentDisplay="RIGHT" lineSpacing="5.0" onAction="#choisirImage" prefHeight="27.0" prefWidth="117.0" style="-fx-background-color: #00BCD4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 5 7;" text="Choose Image" GridPane.columnIndex="2" GridPane.rowIndex="4" />

                    <!-- Category Field -->
                    <Label style="-fx-font-weight: bold;" text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <ComboBox fx:id="categoryCombo" promptText="Select Category" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                </GridPane>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
                    <Button onAction="#ajouterProduit" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 20;" text="Add" />
                    <Button onAction="#modifierProduit" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 20;" text="Update" />
                    <Button onAction="#supprimerProduit" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 20;" text="Delete" />
                    <Button onAction="#clearFields" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 20;" text="Clear" />
                </HBox>
            </children>
        </VBox>

        <!-- Table Section with Border -->
        <TableView fx:id="productsTable" style="-fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="350">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50" style="-fx-font-weight: bold;" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="150" style="-fx-font-weight: bold;" text="Name" />
                <TableColumn fx:id="priceColumn" prefWidth="80" style="-fx-font-weight: bold; -fx-alignment: CENTER_RIGHT;" text="Price" />
                <TableColumn fx:id="quantityColumn" prefWidth="80" style="-fx-font-weight: bold; -fx-alignment: CENTER;" text="Quantity" />
                <TableColumn fx:id="imageColumn" prefWidth="200" style="-fx-font-weight: bold;" text="Image Path" />
                <TableColumn fx:id="categoryColumn" prefWidth="120" style="-fx-font-weight: bold;" text="Category" />
                <TableColumn fx:id="descriptionColumn" prefWidth="250" style="-fx-font-weight: bold;" text="Description" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</AnchorPane>
