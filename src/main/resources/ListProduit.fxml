<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ListeProduitController">
    <!-- Top Navigation Bar -->
    <HBox alignment="CENTER_LEFT" layoutX="0.0" layoutY="0.0" prefHeight="50.0" prefWidth="900.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);">
        <padding>
            <Insets left="20" right="20" />
        </padding>
        <children>
            <ImageView fitHeight="63.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@images/sahatech_logo.png" />
                </image>
            </ImageView>
            <Region HBox.hgrow="ALWAYS" />
        </children>
    </HBox>

    <!-- Main Content Area -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" layoutX="0.0" layoutY="50.0" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: transparent; -fx-background: transparent;">
        <content>
            <VBox spacing="20" style="-fx-background-color: transparent; -fx-padding: 20 25;">
                <!-- Page Title -->
                <HBox alignment="CENTER_LEFT">
                    <Label alignment="TOP_CENTER" prefHeight="30.0" prefWidth="771.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Product Management" />
                </HBox>

                <!-- Form Container -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2); -fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;" />

                    <Line endX="700.0" startX="0.0" style="-fx-stroke: #f0f0f0; -fx-stroke-width: 1.5;" />

                    <HBox spacing="15" style="-fx-padding: 15 0 10 0;">
                        <!-- Left Column -->
                        <VBox prefWidth="350" spacing="15">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label prefHeight="19.0" prefWidth="50.0" style="-fx-font-size: 13px; -fx-text-fill: #34495e; -fx-font-weight: bold;" text="Name:" />
                                <TextField fx:id="nameField" prefHeight="35.0" prefWidth="177.0" promptText="Product name" style="-fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-font-size: 13px; -fx-padding: 5 10;" />
                                <Label prefWidth="100" style="-fx-font-size: 13px; -fx-text-fill: #34495e; -fx-font-weight: bold;" text="Category:" />
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label prefHeight="19.0" prefWidth="50.0" style="-fx-font-size: 13px; -fx-text-fill: #34495e; -fx-font-weight: bold;" text="Price:" />
                                <TextField fx:id="priceField" prefHeight="35.0" prefWidth="180.0" promptText="0.00" style="-fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-font-size: 13px; -fx-padding: 5 10;" />
                                <Label prefWidth="100" style="-fx-font-size: 13px; -fx-text-fill: #34495e; -fx-font-weight: bold;" text="Image:" />
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label prefHeight="19.0" prefWidth="49.0" style="-fx-font-size: 13px; -fx-text-fill: #34495e; -fx-font-weight: bold;" text="Quantity:" />
                                <TextField fx:id="quantityField" prefHeight="35.0" prefWidth="179.0" promptText="0" style="-fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-font-size: 13px; -fx-padding: 5 10;" />
                                <Label prefWidth="100" style="-fx-font-size: 13px; -fx-text-fill: #34495e; -fx-font-weight: bold;" text="Description:" />
                            </HBox>
                        </VBox>

                        <!-- Right Column -->
                        <VBox prefWidth="350" spacing="15">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <ComboBox fx:id="categoryCombo" prefHeight="35.0" prefWidth="169.0" promptText="Select Category" style="-fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-font-size: 13px;" />
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <TextField fx:id="imageField" editable="false" prefHeight="35.0" prefWidth="170.0" promptText="No file selected" style="-fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-font-size: 13px; -fx-padding: 5 10;" />
                                <Button onAction="#choisirImage" prefHeight="35.0" prefWidth="106.0" style="-fx-background-color: #00BCD4; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 12px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 1, 0, 0, 1);" text="Browse" />
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <TextField fx:id="descriptionField" prefHeight="35.0" prefWidth="172.0" promptText="Product description" style="-fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-font-size: 13px; -fx-padding: 5 10;" />
                                <Button fx:id="generateDescriptionButton" onAction="#generateAIDescription" prefHeight="32.0" prefWidth="106.0" style="-fx-background-color: #00BCD4; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 12px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 2, 0, 0, 1);" text="Generate AI Description">
                                    <graphic>
                                        <Label style="-fx-text-fill: white; -fx-font-family: 'FontAwesome'; -fx-font-size: 12px; -fx-padding: 0 5 0 0;" text="✨" />
                                    </graphic>
                                </Button>
                            </HBox>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 5 0;">
                        <Region prefWidth="100" />
                    </HBox>

                    <!-- Action Buttons -->
                    <HBox prefHeight="46.0" prefWidth="717.0" spacing="15" style="-fx-padding: 10 0 0 0;">
                        <Button onAction="#ajouterProduit" prefHeight="35.0" prefWidth="91.0" style="-fx-background-color: #00BCD4; -fx-text-fill: white; -fx-background-radius: 18; -fx-font-size: 13px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 2, 0, 0, 1);" text="Add Product">
                            <graphic>
                                <Label style="-fx-text-fill: white; -fx-font-family: 'FontAwesome'; -fx-font-size: 12px; -fx-padding: 0 5 0 0;" text="+" />
                            </graphic>
                        </Button>
                        <Button onAction="#modifierProduit" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #00BCD4; -fx-text-fill: white; -fx-background-radius: 18; -fx-font-size: 13px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 2, 0, 0, 1);" text="Update">
                            <graphic>
                                <Label style="-fx-text-fill: white; -fx-font-family: 'FontAwesome'; -fx-font-size: 12px; -fx-padding: 0 5 0 0;" text="✓" />
                            </graphic>
                        </Button>
                        <Button onAction="#supprimerProduit" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #00BCD4; -fx-text-fill: white; -fx-background-radius: 18; -fx-font-size: 13px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 2, 0, 0, 1);" text="Delete">
                            <graphic>
                                <Label style="-fx-text-fill: white; -fx-font-family: 'FontAwesome'; -fx-font-size: 12px; -fx-padding: 0 5 0 0;" text="×" />
                            </graphic>
                        </Button>
                        <Button onAction="#clearFields" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #00BCD4; -fx-text-fill: white; -fx-background-radius: 18; -fx-font-size: 13px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 2, 0, 0, 1);" text="Clear">
                            <graphic>
                                <Label style="-fx-text-fill: white; -fx-font-family: 'FontAwesome'; -fx-font-size: 12px; -fx-padding: 0 5 0 0;" text="⟲" />
                            </graphic>
                        </Button>
                        <Button onAction="#handleBackToAdmin" prefHeight="32.0" prefWidth="173.0" style="-fx-background-color: #00BCD4; -fx-text-fill: white; -fx-background-radius: 16; -fx-font-size: 12px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 2, 0, 0, 1);" text="Back to Dashboard">
                            <graphic>
                                <Label style="-fx-text-fill: white; -fx-font-family: 'FontAwesome'; -fx-font-size: 12px; -fx-padding: 0 5 0 0;" text="←" />
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Products Table Container -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2); -fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                        <Label alignment="TOP_CENTER" prefHeight="26.0" prefWidth="720.0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Products List" />
                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>

                    <Line endX="700.0" startX="0.0" style="-fx-stroke: #f0f0f0; -fx-stroke-width: 1.5;" />

                    <TableView fx:id="productsTable" prefHeight="220.0" prefWidth="850.0" style="-fx-background-radius: 5; -fx-border-color: #f0f0f0; -fx-border-radius: 5; -fx-padding: 3; -fx-font-size: 12px;">
                        <columns>
                            <TableColumn fx:id="idColumn" prefWidth="50" style="-fx-alignment: CENTER;" text="ID" />
                            <TableColumn fx:id="nameColumn" prefWidth="150" text="Product Name" />
                            <TableColumn fx:id="priceColumn" prefWidth="80" style="-fx-alignment: CENTER-RIGHT;" text="Price" />
                            <TableColumn fx:id="quantityColumn" prefWidth="80" style="-fx-alignment: CENTER;" text="Quantity" />
                            <TableColumn fx:id="categoryColumn" prefWidth="100" text="Category" />
                            <TableColumn fx:id="imageColumn" prefWidth="120" text="Image Path" />
                            <TableColumn fx:id="descriptionColumn" prefWidth="270" text="Description" />
                        </columns>
                        <effect>
                            <DropShadow color="#0000000d" height="3.0" radius="1.0" width="3.0" />
                        </effect>
                    </TableView>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>